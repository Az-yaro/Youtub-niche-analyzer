
print("     Welcome to the Youtube intersection Niche Analyzer!!!","\n", "_"*60)
retention_multiplier = 1.5

def channel_analyzer(channel_name, ctr, avg_duration, recent_views, aesthetics):

    def calculate_score():
        score = (ctr*avg_duration) * retention_multiplier
        if score >= 500:
            return "HOT"
        elif score >= 100:
            return "WARM"
        else:
            return "COLD"       
    def evaluate_momentum():
        try:
            avg_views = sum(recent_views)/len(recent_views)
            return round(avg_views)
        except ZeroDivisionError:
            print(">>>Average View: No video available on this channel yet!")
    def viral_videos():
        return list(filter(lambda view: view > 100000, recent_views))
    def log_aesthetics():
        return list(aesthetics.values())

    print(f">>> Channel: {channel_name}")
    print(f">>> Score Rating: {calculate_score()}")
    print(f">>> Average Views: {evaluate_momentum()}")
    print(f">>> Trending Videos: {viral_videos()}")
    print(f">>> Channel Styles: {log_aesthetics()}")

incoming_webhook_data = {"channel_name":"Automation Leaners Lab", "ctr":21, "avg_duration":43, "recent_views":[2010,39389,100000,320000,429000], "aesthetics":{"format":"personal hype", "Camera_lens":"450mm", "camera":"cinematic", "lighting":"raw"}}

channel_analyzer(**incoming_webhook_data)

